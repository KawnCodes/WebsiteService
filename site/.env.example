# Copy to .env and fill in. All of these are PUBLIC values (they end up in the page),
# so none of them are secrets. Never put a Stripe SECRET key (sk_...) anywhere in this site.

# Your live domain, no trailing slash
PUBLIC_SITE_URL=https://runningtab.co.uk

# Stripe Payment Links (Stripe Dashboard > Payment Links), subscription mode.
# Leave blank to hide the "Sign up" buttons; "Book a chat" still works.
PUBLIC_STRIPE_LINK_CORE=
PUBLIC_STRIPE_LINK_PLUS=
PUBLIC_STRIPE_LINK_GROUP=
PUBLIC_STRIPE_LINK_FOUNDING=
# Stripe Customer Portal login link (lets clients update card / cancel)
PUBLIC_STRIPE_PORTAL_URL=

# Lead form: Web3Forms access key (free; this key is designed to be public)
PUBLIC_FORM_ACCESS_KEY=

# Cal.com (or similar) booking link for 15-minute chats
PUBLIC_BOOKING_URL=

# Contact details shown on the site
PUBLIC_CONTACT_EMAIL=hello@runningtab.co.uk
# WhatsApp number in international format without + or spaces, e.g. 447700900000
PUBLIC_WHATSAPP_NUMBER=

# Cloudflare Web Analytics token (cookieless). Leave blank to disable.
PUBLIC_CF_ANALYTICS_TOKEN=
