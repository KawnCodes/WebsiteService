---
import Base from '../layouts/Base.astro';
---
<Base title="Thanks, we’ve got it" noindex>
  <section class="hero">
    <div class="narrow center">
      <p class="eyebrow">Message received</p>
      <h1>Thanks, we’ll be in touch</h1>
      <p class="lead">We reply within 1 working day. If you mentioned your venue, we’ll usually send a free homepage mockup within 2 working days.</p>
      <div class="btn-row" style="justify-content:center"><a class="btn btn-secondary" href="/portfolio">See example sites</a></div>
    </div>
  </section>
</Base>
