---
import Logo from './Logo.astro';
import { nav, business } from '../config';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${business.name} home`}><Logo /></a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="btn btn-primary" href="/contact">Book a free chat</a>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navEl = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = navEl?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Close' : 'Menu';
  });
</script>
