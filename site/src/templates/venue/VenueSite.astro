---
// Reusable client site template. One JSON file per venue (see site/demos/*.json
// and ops/delivery once Phase 5 exists). Everything a venue changes often (menu,
// hours, notice, events) lives in the JSON, so an edit request is usually a
// one-line data change.
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';

export interface MenuItem { name: string; desc?: string; price: string; tags?: string[] }
export interface Venue {
  slug: string;
  demo?: boolean;
  name: string;
  schemaType: string;
  kind: string;
  tagline: string;
  intro: string;
  address: { street: string; locality: string; postcode?: string };
  phone: string;
  email: string;
  instagram?: string;
  booking?: { label: string; url: string } | null;
  notice?: string;
  formAccessKey?: string;
  theme: { bg: string; surface: string; text: string; muted: string; accent: string; accentText: string; highlight: string; heading: 'serif' | 'sans' };
  hours: { day: string; open: string; close: string }[];
  menu: { section: string; note?: string; items: MenuItem[] }[];
  dietaryNote?: string;
  about: { heading: string; body: string[] };
  events?: { date: string; title: string; desc: string }[];
  privateHire?: { heading: string; body: string; capacity?: string } | null;
  gallery?: string[];
  faqs?: { q: string; a: string }[];
}

interface Props { venue: Venue; canonical?: string; noindex?: boolean }
const { venue: v, canonical, noindex = false } = Astro.props;

const dayCodes: Record<string, string> = { Monday: 'Mo', Tuesday: 'Tu', Wednesday: 'We', Thursday: 'Th', Friday: 'Fr', Saturday: 'Sa', Sunday: 'Su' };
const fmt = (t: string) => {
  if (!t) return '';
  const [h, m] = t.split(':').map(Number);
  if (h === 23 && m === 59) return 'midnight';
  const suffix = h >= 12 ? 'pm' : 'am';
  const h12 = h % 12 || 12;
  return m ? `${h12}:${String(m).padStart(2, '0')}${suffix}` : `${h12}${suffix}`;
};
const fullAddress = [v.address.street, v.address.locality, v.address.postcode].filter(Boolean).join(', ');
const mapUrl = `https://www.openstreetmap.org/search?query=${encodeURIComponent(`${v.name} ${fullAddress}`)}`;
const telHref = `tel:${v.phone.replace(/\s/g, '')}`;
const title = `${v.name} | ${v.kind} in ${v.address.locality}`;

const ld = {
  '@context': 'https://schema.org',
  '@type': v.schemaType,
  name: v.name,
  description: v.intro,
  telephone: v.phone,
  email: v.email,
  address: { '@type': 'PostalAddress', streetAddress: v.address.street, addressLocality: v.address.locality, postalCode: v.address.postcode || undefined, addressCountry: 'GB' },
  openingHoursSpecification: v.hours.filter((h) => h.open).map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: `https://schema.org/${h.day}`, opens: h.open, closes: h.close })),
  hasMenu: {
    '@type': 'Menu',
    hasMenuSection: v.menu.map((s) => ({
      '@type': 'MenuSection',
      name: s.section,
      hasMenuItem: s.items.map((i) => ({ '@type': 'MenuItem', name: i.name, description: i.desc || undefined, offers: { '@type': 'Offer', price: i.price, priceCurrency: 'GBP' } })),
    })),
  },
  url: canonical,
};
const css = `--bg:${v.theme.bg};--surface:${v.theme.surface};--text:${v.theme.text};--muted:${v.theme.muted};--accent:${v.theme.accent};--accent-text:${v.theme.accentText};--hl:${v.theme.highlight};--head:${v.theme.heading === 'serif' ? "'Fraunces Variable', Georgia, serif" : "'Inter Variable', system-ui, sans-serif"}`;
const hoursJson = JSON.stringify(v.hours);
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={`${v.tagline} ${v.intro}`.slice(0, 158)} />
  {canonical && <link rel="canonical" href={canonical} />}
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={v.tagline} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content={v.theme.bg} />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <style set:html={`:root{${css}}`}></style>
</head>
<body class="venue">
  {v.demo && (
    <div class="demo-bar">Demo site for a <strong>fictional</strong> venue, built by <a href="/">Running Tab</a>. <a href="/contact">Want one like this?</a></div>
  )}
  {v.notice && <div class="notice-bar" role="status">{v.notice}</div>}
  <header class="v-header">
    <div class="v-wrap v-bar">
      <a class="v-logo" href="#top">{v.name}</a>
      <nav class="v-nav" aria-label="Sections">
        <a href="#menu">Menu</a>
        {v.events?.length ? <a href="#events">What’s on</a> : null}
        {v.privateHire && <a href="#private-hire">Private hire</a>}
        <a href="#visit">Visit</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="v-hero">
      <div class="v-wrap">
        <p class="v-kind">{v.kind} · {v.address.street}, {v.address.locality}</p>
        <h1>{v.tagline}</h1>
        <p class="v-intro">{v.intro}</p>
        <p class="v-status" id="open-status" data-hours={hoursJson}>See opening hours below</p>
        <div class="v-btns">
          {v.booking && <a class="v-btn v-btn-primary" href={v.booking.url}>{v.booking.label}</a>}
          <a class="v-btn v-btn-ghost" href="#menu">See the menu</a>
          <a class="v-btn v-btn-ghost" href={telHref}>Call us</a>
        </div>
      </div>
    </section>

    <section id="menu" class="v-section">
      <div class="v-wrap">
        <h2>Menu</h2>
        <div class="v-menu">
          {v.menu.map((s) => (
            <div class="v-menu-sec">
              <h3>{s.section}</h3>
              {s.note && <p class="v-note">{s.note}</p>}
              <ul>
                {s.items.map((i) => (
                  <li>
                    <div class="v-item-head">
                      <span class="v-item-name">{i.name}{i.tags?.length ? <span class="v-tags">{i.tags.join(' · ')}</span> : null}</span>
                      <span class="v-price">£{i.price}</span>
                    </div>
                    {i.desc && <p>{i.desc}</p>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        {v.dietaryNote && <p class="v-diet">{v.dietaryNote}</p>}
      </div>
    </section>

    <section class="v-section v-alt">
      <div class="v-wrap v-two">
        <div>
          <h2>{v.about.heading}</h2>
          {v.about.body.map((p) => <p>{p}</p>)}
        </div>
        {v.gallery?.length ? (
          <div class="v-gallery" aria-label="Photo gallery (placeholders)">
            {v.gallery.map((g, i) => <div class={`v-tile t${i % 3}`}><span>{g}</span></div>)}
          </div>
        ) : null}
      </div>
    </section>

    {v.events?.length ? (
      <section id="events" class="v-section">
        <div class="v-wrap">
          <h2>What’s on</h2>
          <div class="v-cards">
            {v.events.map((e) => (
              <article class="v-card"><p class="v-date">{e.date}</p><h3>{e.title}</h3><p>{e.desc}</p></article>
            ))}
          </div>
        </div>
      </section>
    ) : null}

    {v.privateHire && (
      <section id="private-hire" class="v-section v-alt">
        <div class="v-wrap v-two">
          <div>
            <h2>{v.privateHire.heading}</h2>
            <p>{v.privateHire.body}</p>
            {v.privateHire.capacity && <p class="v-note">{v.privateHire.capacity}</p>}
          </div>
          <form class="v-form" action="https://api.web3forms.com/submit" method="POST">
            {v.formAccessKey ? <input type="hidden" name="access_key" value={v.formAccessKey} /> : null}
            <input type="hidden" name="subject" value={`Private hire enquiry: ${v.name}`} />
            <label>Name<input name="name" required autocomplete="name" /></label>
            <label>Email<input type="email" name="email" required autocomplete="email" /></label>
            <div class="v-row">
              <label>Date<input type="date" name="date" /></label>
              <label>Guests<input type="number" name="guests" min="1" /></label>
            </div>
            <label>Tell us about your event<textarea name="message" rows="3"></textarea></label>
            {v.formAccessKey
              ? <button class="v-btn v-btn-primary" type="submit">Send enquiry</button>
              : <p class="v-note">Demo form: enquiries are switched off on this example site.</p>}
          </form>
        </div>
      </section>
    )}

    <section id="visit" class="v-section">
      <div class="v-wrap v-two">
        <div>
          <h2>Visit us</h2>
          <p class="v-big">{fullAddress}</p>
          <p><a href={mapUrl} rel="noopener">Open in maps</a> · <a href={telHref}>{v.phone}</a> · <a href={`mailto:${v.email}`}>{v.email}</a></p>
          {v.booking && <p id="book"><a class="v-btn v-btn-primary" href={v.booking.url}>{v.booking.label}</a></p>}
          {v.faqs?.length ? (
            <div class="v-faqs">
              {v.faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
            </div>
          ) : null}
        </div>
        <div>
          <h3>Opening hours</h3>
          <table class="v-hours">
            <tbody>
              {v.hours.map((h) => (
                <tr data-day={dayCodes[h.day]}><th scope="row">{h.day}</th><td>{h.open ? `${fmt(h.open)} – ${fmt(h.close)}` : 'Closed'}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <footer class="v-footer">
    <div class="v-wrap">
      <p><strong>{v.name}</strong> · {fullAddress}</p>
      <p class="v-small">Website by <a href="https://runningtab.co.uk">Running Tab</a></p>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var el = document.getElementById('open-status');
      if (!el) return;
      var hours = JSON.parse(el.getAttribute('data-hours'));
      var parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', weekday: 'long', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
      var get = function (t) { return (parts.find(function (p) { return p.type === t; }) || {}).value; };
      var day = get('weekday'), now = get('hour') + ':' + get('minute');
      var today = hours.find(function (h) { return h.day === day; });
      var row = document.querySelector('.v-hours tr:nth-child(' + (hours.indexOf(today) + 1) + ')');
      if (row) row.classList.add('today');
      var label = function (t) { var h = +t.slice(0, 2), m = t.slice(3); if (t === '23:59') return 'midnight'; return (h % 12 || 12) + (m !== '00' ? ':' + m : '') + (h >= 12 ? 'pm' : 'am'); };
      if (today && today.open && now >= today.open && now < today.close) {
        el.textContent = 'Open now · until ' + label(today.close);
        el.classList.add('open');
      } else if (today && today.open && now < today.open) {
        el.textContent = 'Closed now · opens at ' + label(today.open) + ' today';
      } else {
        el.textContent = 'Closed now · see opening hours below';
      }
    })();
  </script>
</body>
</html>

<style is:global>
  .venue { margin: 0; background: var(--bg); color: var(--text); font-family: 'Inter Variable', system-ui, sans-serif; font-size: 1.0625rem; line-height: 1.6; }
  .venue *, .venue *::before, .venue *::after { box-sizing: border-box; }
  .venue h1, .venue h2, .venue h3 { font-family: var(--head); line-height: 1.15; margin: 0 0 .5em; font-weight: 650; }
  .venue h1 { font-size: clamp(2rem, 6vw, 3.4rem); max-width: 18ch; }
  .venue h2 { font-size: clamp(1.6rem, 4vw, 2.3rem); }
  .venue a { color: inherit; text-underline-offset: 3px; }
  .venue :focus-visible { outline: 3px solid var(--hl); outline-offset: 2px; }
  .v-wrap { width: min(100% - 32px, 1080px); margin-inline: auto; }
  .demo-bar { background: #111; color: #eee; font-size: .9rem; text-align: center; padding: 8px 16px; }
  .demo-bar a { color: #ffd27a; }
  .notice-bar { background: var(--hl); color: #1a1614; text-align: center; padding: 10px 16px; font-weight: 600; font-size: .95rem; }
  .v-header { position: sticky; top: 0; z-index: 10; background: var(--bg); border-bottom: 1px solid color-mix(in srgb, var(--text) 12%, transparent); }
  .v-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; flex-wrap: wrap; }
  .v-logo { font-family: var(--head); font-weight: 700; font-size: 1.3rem; text-decoration: none; }
  .v-nav { display: flex; gap: 18px; flex-wrap: wrap; }
  .v-nav a { text-decoration: none; font-weight: 500; }
  .v-nav a:hover { color: var(--accent); }
  @media (max-width: 560px) { .v-nav { gap: 14px; font-size: .95rem; padding-bottom: 10px; } }
  .v-hero { padding: clamp(48px, 10vw, 112px) 0 clamp(40px, 7vw, 80px); }
  .v-kind { text-transform: uppercase; letter-spacing: .08em; font-size: .85rem; font-weight: 600; color: var(--muted); }
  .v-intro { font-size: 1.2rem; max-width: 56ch; color: var(--muted); }
  .v-status { display: inline-block; padding: 6px 14px; border-radius: 999px; background: color-mix(in srgb, var(--text) 8%, transparent); font-weight: 600; font-size: .95rem; }
  .v-status.open::before { content: '●'; color: #3fa564; margin-right: 8px; }
  .v-btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
  .v-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 12px 22px; border-radius: 999px; font-weight: 600; text-decoration: none; border: 2px solid var(--accent); cursor: pointer; font: inherit; font-weight: 600; }
  .v-btn-primary { background: var(--accent); color: var(--accent-text) !important; }
  .v-btn-ghost { background: transparent; color: var(--text); border-color: color-mix(in srgb, var(--text) 35%, transparent); }
  .v-section { padding: clamp(48px, 8vw, 88px) 0; }
  .v-alt { background: var(--surface); }
  .v-two { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  @media (max-width: 820px) { .v-two { grid-template-columns: 1fr; } }
  .v-menu { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px 48px; }
  .v-menu-sec h3 { font-size: 1.35rem; border-bottom: 2px solid var(--accent); padding-bottom: 6px; }
  .v-menu ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .v-menu li p { margin: 2px 0 0; color: var(--muted); font-size: .95rem; }
  .v-item-head { display: flex; justify-content: space-between; gap: 12px; font-weight: 600; }
  .v-price { white-space: nowrap; }
  .v-tags { font-size: .75rem; font-weight: 700; margin-left: 8px; color: var(--accent); letter-spacing: .04em; }
  .v-note { color: var(--muted); font-size: .95rem; margin-top: -4px; }
  .v-diet { margin-top: 32px; font-size: .9rem; color: var(--muted); border-top: 1px solid color-mix(in srgb, var(--text) 12%, transparent); padding-top: 16px; }
  .v-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .v-tile { aspect-ratio: 1; border-radius: 10px; display: flex; align-items: flex-end; padding: 10px; font-size: .8rem; font-weight: 600; color: #fff; text-shadow: 0 1px 2px rgb(0 0 0 / 50%); }
  .v-tile.t0 { background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 50%, #000)); }
  .v-tile.t1 { background: linear-gradient(135deg, var(--hl), color-mix(in srgb, var(--hl) 50%, #000)); }
  .v-tile.t2 { background: linear-gradient(135deg, var(--muted), color-mix(in srgb, var(--muted) 40%, #000)); }
  .v-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
  .v-card { background: var(--surface); border: 1px solid color-mix(in srgb, var(--text) 10%, transparent); border-radius: 14px; padding: 22px; }
  .v-alt .v-card { background: var(--bg); }
  .v-date { color: var(--accent); font-weight: 700; font-size: .9rem; margin: 0 0 6px; }
  .v-card p:last-child { margin-bottom: 0; color: var(--muted); }
  .v-form { display: grid; gap: 14px; background: var(--bg); padding: 24px; border-radius: 14px; }
  .v-form label { display: grid; gap: 6px; font-weight: 600; font-size: .95rem; }
  .v-form input, .v-form textarea { font: inherit; padding: 11px 13px; border-radius: 10px; border: 1.5px solid color-mix(in srgb, var(--text) 25%, transparent); background: var(--surface); color: var(--text); width: 100%; }
  .v-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .v-big { font-size: 1.25rem; font-weight: 600; }
  .v-hours { width: 100%; border-collapse: collapse; }
  .v-hours th, .v-hours td { text-align: left; padding: 10px 0; border-bottom: 1px solid color-mix(in srgb, var(--text) 12%, transparent); }
  .v-hours th { font-weight: 500; }
  .v-hours tr.today { font-weight: 700; color: var(--accent); }
  .v-hours tr.today th { font-weight: 700; }
  .v-faqs details { border-bottom: 1px solid color-mix(in srgb, var(--text) 12%, transparent); padding: 12px 0; }
  .v-faqs summary { cursor: pointer; font-weight: 600; }
  .v-faqs p { margin: 8px 0 0; color: var(--muted); }
  .v-footer { padding: 32px 0; border-top: 1px solid color-mix(in srgb, var(--text) 12%, transparent); }
  .v-small { font-size: .85rem; color: var(--muted); }
</style>
